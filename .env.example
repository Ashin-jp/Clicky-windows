# ─── AI Providers ────────────────────────────────────────────────────
# Get your Groq API key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Get your Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Cloudflare Worker (optional, for Claude + ElevenLabs) ───────────
# Deploy the worker in /worker, then set the URL here
WORKER_BASE_URL=https://your-worker-name.your-subdomain.workers.dev

# ─── ElevenLabs (optional) ───────────────────────────────────────────
# Your ElevenLabs voice ID (used in worker/wrangler.toml)
ELEVENLABS_VOICE_ID=your_voice_id_here

# ─── Data Directory (optional, defaults to ~/Clicky) ─────────────────
# CLICKY_DATA_DIR=D:/Clicky
